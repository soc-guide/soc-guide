{
  "name": "soc-guide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "data:build": "python scripts/extract_guide_data.py",
    "validate:data": "node scripts/validate-data.mjs",
    "check": "npm run typecheck && npm run validate:data && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "prettier": "3.9.6"
  },
  "description": "Community-maintained Sword of Convallaria guide for characters, gear, tarot, and lore.",
  "engines": {
    "node": ">=22"
  }
}
